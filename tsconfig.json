{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "types": ["node", "vitest/globals", "chrome"],
    "jsx": "react-jsx",
    "skipLibCheck": true
  },
  "include": ["entrypoints", "scripts", "src", "tests", "wxt.config.ts", "vitest.config.ts", ".wxt/wxt.d.ts"]
}
