{
  "name": "tabroute",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "prepare": "wxt prepare",
    "dev": "wxt",
    "build": "wxt build -b chrome",
    "zip": "wxt zip -b chrome",
    "verify:zip": "tsx scripts/workbench/verify-zip.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && npm run lint:architecture",
    "lint:architecture": "tsx scripts/check-chrome-mutations.ts",
    "format:check": "prettier entrypoints/background.ts > /tmp/background.prettier.ts && diff -u entrypoints/background.ts /tmp/background.prettier.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "build:workbench": "tsx scripts/workbench/cli.ts build-workbench",
    "workbench": "tsx scripts/workbench/cli.ts workbench --mode fixture",
    "workbench:real": "tsx scripts/workbench/cli.ts workbench --mode real",
    "test:workbench": "tsx scripts/workbench/cli.ts test-workbench",
    "test:extension": "tsx scripts/workbench/cli.ts test-extension",
    "smoke:popup": "tsx scripts/workbench/cli.ts smoke-popup",
    "docs:chrome:update": "tsx scripts/update-chrome-docs.ts",
    "docs:chrome:validate": "tsx scripts/update-chrome-docs.ts --check",
    "test:docs": "vitest run tests/unit/update-chrome-docs.test.ts"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/chrome": "0.2.5",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.10",
    "@wxt-dev/module-react": "1.2.2",
    "cheerio": "1.2.0",
    "eslint": "10.8.1",
    "eslint-formatter-unix": "^9.0.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tsx": "4.23.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wxt": "0.21.3"
  }
}
